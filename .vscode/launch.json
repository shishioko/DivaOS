{
    "version": "0.2.0",
    "configurations": [{
        "name": "Debug (QEMU, GDB)",
        "type": "cppdbg",

        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "miDebuggerServerAddress": "localhost:3333",
        "cwd": "${workspaceFolder}/",
        "setupCommands": [{
            "text": "set target-async on",
            "ignoreFailures": false
        }],
        "hardwareBreakpoints": {
            "require": true,
        },

        "stopAtEntry": false,
        "externalConsole": true,
        
        "request": "launch",
        "program": "${workspaceFolder}/Build/Kernel.sym",
        "targetArchitecture": "x86_64",

        "preLaunchTask": "Start Debugging (QEMU, GDB)",
        "postDebugTask": "Stop Debugging (QEMU, GDB)"
    }],
}