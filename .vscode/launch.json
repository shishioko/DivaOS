{
    "version": "0.2.0",
    "configurations": [{
        "name": "Debug (QEMU, GDB)",
        "type": "cppdbg",

        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "miDebuggerServerAddress": "localhost:3333",
        "cwd": "${workspaceFolder}/",
        "setupCommands": [{
            "description": "Load kernel symbols",
            "text": "add-symbol-file ${workspaceFolder}/Build/Kernel.sym",
            "ignoreFailures": false
        }],

        "stopAtEntry": false,
        "externalConsole": true,
        
        "request": "launch",
        "program": "${workspaceFolder}/Build/Loader.sym",

        "preLaunchTask": "Start Debugging (QEMU, GDB)",
        "postDebugTask": "Stop Debugging (QEMU, GDB)"
    }],
}